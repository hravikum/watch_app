+{# Returned by a /review card action over HTMX (4N): replaces the card with a
+   slim, muted row (a trail of what you did this pass) and OOB-updates the "to
+   go" count in the header. A deleted maker gets no link — its page is gone. #}
+<div class="px-5 py-3 text-sm text-stone-400 border border-stone-100 rounded-xl bg-stone-50/60 flex items-center gap-2">
+  <span aria-hidden="true">✓</span>
+  {% if link %}
+  <a href="/makers/{{ maker_id }}"
+     class="hover:underline decoration-stone-300 underline-offset-2">{{ name }}</a>
+  {% else %}
+  <span>{{ name }}</span>
+  {% endif %}
+  <span class="text-stone-300">·</span>
+  <span>{{ action }}</span>
+</div>
+<strong id="review-to-go" class="text-stone-900" hx-swap-oob="true">{{ to_go }}</strong>
